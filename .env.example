# PayPal sandbox app (developer.paypal.com > Apps & Credentials). Never commit real values.
PAYPAL_MODE=sandbox            # or "mock" to run without PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=             # from the sandbox webhook you register for /webhooks/paypal

# Sandbox business accounts that receive supplier payouts
SUPPLIER_A_EMAIL=
SUPPLIER_B_EMAIL=
SUPPLIER_C_EMAIL=

# Any OpenAI-compatible endpoint (default: Otari). Empty key = heuristics only.
LLM_BASE_URL=https://otari.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepinfra:Qwen/Qwen3-235B-A22B-Instruct-2507

# Owner actions (approve, rules, demo knobs) need this token when set
ADMIN_TOKEN=
APP_URL=http://localhost:3000

# Optional owner alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
